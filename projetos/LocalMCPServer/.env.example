# Caminho dos documentos (relativo a raiz do projeto)
DOCUMENTS_PATH=./data/documents

# Chave de API do Groq (obter em https://console.groq.com)
GROQ_API_KEY=sua_chave_aqui

# LangSmith (opcional - para rastreamento de traces)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=sua_chave_aqui
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=mcp-file-server
